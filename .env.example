# Leave DATABASE_URL unset to run the embedded database (no install, data in ./.data/db).
# Set it to use your own Postgres or Supabase (use the session pooler URL on Supabase).
# DATABASE_URL=postgresql://user:password@host:5432/dbname

# Where the embedded database lives. Default ./.data/db
# DATA_DIR=./.data/db

# Sending. Leave unset and `send` only writes the outbox; nothing goes out.
# A Postmark server token, used only by `send --live` and `send-flows --live`.
# POSTMARK_SERVER_TOKEN=
